# ════════════════════════════════════════════════════════════════════════
# GitroHub — environment variables (.env.example)
#
# Copy this file to .env and fill in the lines marked CHANGE_ME.
# Every other value shown is the built-in default; uncomment a line only to change it.
# On Railway, set the same names under your service → Variables instead of using a file.
# ════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────
# 1 · REQUIRED — the bot and GitHub
# Without these the bot will not start.
# ────────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (/newbot).
BOT_TOKEN=CHANGE_ME_from_BotFather

# Your bot's username, without the @ (used in deep links back into the bot).
BOT_USERNAME=CHANGE_ME_without_the_at_sign

# Client ID of your GitHub OAuth App (github.com/settings/developers → New OAuth App).
GITHUB_CLIENT_ID=CHANGE_ME_oauth_client_id

# Client secret of that OAuth App. Also used to REVOKE a person's access on GitHub when they disconnect or are banned.
GITHUB_CLIENT_SECRET=CHANGE_ME_oauth_client_secret

# Public HTTPS URL of this service, no trailing slash. The OAuth callback is BASE_URL/callback and must match the OAuth App exactly.
BASE_URL=https://your-app.up.railway.app

# Postgres connection string (Railway's Postgres plugin sets this for you). Tables are created automatically on boot.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis connection string (Railway's Redis plugin sets this for you). Holds sessions, wizard state and short-lived buffers.
REDIS_URL=redis://default:password@host:6379

# ────────────────────────────────────────────────────────────────────────
# 2 · REQUIRED — secrets (generate your own, never reuse)
# Generate each with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ────────────────────────────────────────────────────────────────────────

# Signs the OAuth "state" value that protects the GitHub login. Use a long random value.
SESSION_JWT_SECRET=CHANGE_ME_64_hex_chars

# AES-256-GCM key (64 hex characters) that encrypts every GitHub token and webhook secret at rest. If you ever change it, stored tokens can no longer be read and people are simply asked to reconnect.
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# Shared secret Telegram echoes back on every webhook call (openssl rand -hex 24). Production only; derived from the bot token if unset.
# TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_48_hex_chars

# ────────────────────────────────────────────────────────────────────────
# 3 · Administrators
# Roles are seeded from these at first boot; after that super admins manage them in the Dashboard (👑 Admins).
# ────────────────────────────────────────────────────────────────────────

# The ONE protected Owner: their role can never be changed through the Dashboard. Get your ID from @userinfobot. The Owner is ALWAYS an admin and a super admin — no need to repeat it in ADMIN_IDS. Falls back to ADMIN_ID, then the first ADMIN_IDS entry.
OWNER_ID=CHANGE_ME_your_numeric_telegram_id
# 🌐 Owner web panel at <BASE_URL>/owner (v2.2.0). On by default; reached only through the bot (/owner, owner only). Set to off to disable it entirely.
# OWNER_WEB=off

# Extra admins (comma-separated Telegram IDs) who see the 🛡️ Admin Dashboard. They work TOGETHER with OWNER_ID — the roster is OWNER_ID + ADMIN_ID + ADMIN_IDS combined. (The older single-value ADMIN_ID is still accepted.)
# ADMIN_IDS=CHANGE_ME_comma_separated_ids

# Subset of admins that start as super admins (broadcast, permanent Delete User, bulk hub, global config, role management). Unset = every admin. The Owner is always a super admin.
# SUPER_ADMIN_IDS=

# ────────────────────────────────────────────────────────────────────────
# 4 · Runtime
# ────────────────────────────────────────────────────────────────────────

# production = Telegram webhook mode (needs BASE_URL). Leave UNSET for local development, which uses long polling.
# NODE_ENV=production

# HTTP port for the Express server (Railway sets this automatically).
# PORT=3000

# debug | info | warn | error
# LOG_LEVEL=info

# Optional label override for a hotfix/canary build. Normally leave unset: the version comes from package.json.
# BOT_VERSION=

# ────────────────────────────────────────────────────────────────────────
# 5 · Memory & stability (Railway free tier = 512 MB)
# See README → Operations.
# ────────────────────────────────────────────────────────────────────────

# Makes V8 respect a real heap ceiling so the process is never hard-killed by the container.
NODE_OPTIONS=--max-old-space-size=384

# RSS ceiling for the self-watchdog, which shuts down cleanly (closing Postgres/Redis) before the kernel has to.
# MEMORY_WATCHDOG_MB=400

# Max Postgres connections. Raise it if many people use the bot at once.
# PG_POOL_MAX=3

# How long wizard/session state survives in Redis (default 24 h).
# SESSION_TTL_SECONDS=86400

# Queued updates allowed per person before extra taps are dropped with a "slow down".
# USER_MAX_PENDING_UPDATES=25

# Set to 1 to queue Redis commands while it is down instead of failing fast.
# REDIS_OFFLINE_QUEUE=

# People whose repo list is cached in memory at once.
# REPO_CACHE_MAX_USERS=400

# Cached git trees (weighted by size).
# TREE_CACHE_MAX_ENTRIES=300

# In-process budget for uploaded file bytes awaiting commit.
# FILEBUF_MAX_MEMORY_MB=96

# Budget for the Redis write-through copy of those bytes.
# FILEBUF_REDIS_BUDGET_MB=256

# ────────────────────────────────────────────────────────────────────────
# 6 · Limits & concurrency gates
# Protect the service for everyone; each gate has a concurrent slot count and a bounded queue.
# ────────────────────────────────────────────────────────────────────────

# Default actions per person per hour (0 = unlimited; admins can override per account).
# DEFAULT_HOURLY_ACTION_CAP=0

# ZIP/TAR extractions running at once.
# ARCHIVE_MAX_CONCURRENCY=2

# Extractions allowed to wait.
# ARCHIVE_MAX_QUEUE=20

# Worker-thread time limit for one extraction.
# ARCHIVE_TIMEOUT_MS=60000

# Repo downloads at once.
# DOWNLOAD_MAX_CONCURRENCY=3

# Downloads allowed to wait.
# DOWNLOAD_MAX_QUEUE=30

# Largest repo (KB) the bot will download.
# DOWNLOAD_MAX_REPO_KB=256000

# Upload commits at once.
# UPLOAD_MAX_CONCURRENCY=4

# Uploads allowed to wait.
# UPLOAD_MAX_QUEUE=40

# Upload commits one person may run at once.
# UPLOAD_PER_USER_CONCURRENCY=1

# Bulk jobs at once.
# BULK_MAX_CONCURRENCY=3

# Bulk jobs allowed to wait.
# BULK_MAX_QUEUE=30

# How long a job may wait in any gate queue.
# QUEUE_TIMEOUT_MS=60000

# Parallel blob uploads inside one commit.
# GITHUB_BLOB_CONCURRENCY=4

# ────────────────────────────────────────────────────────────────────────
# 7 · GitHub traffic control
# Queue, per-token lanes, retries and circuit breaker in front of every GitHub call (full list in src/lib/githubTraffic/config.js).
# ────────────────────────────────────────────────────────────────────────

# GitHub requests in flight across everyone.
# GITHUB_MAX_CONCURRENCY=20

# Share of those reserved for background jobs.
# GITHUB_BACKGROUND_CONCURRENCY=4

# In-flight requests per GitHub token.
# GITHUB_PER_IDENTITY_CONCURRENCY=6

# Requests allowed to wait overall.
# GITHUB_MAX_QUEUE_SIZE=500

# Requests one person may have waiting.
# GITHUB_PER_USER_MAX_QUEUE=60

# Wait limit for an interactive request.
# GITHUB_QUEUE_TIMEOUT_MS=20000

# Wait limit for a background request.
# GITHUB_BACKGROUND_QUEUE_TIMEOUT_MS=300000

# Time limit for one GitHub call.
# GITHUB_REQUEST_TIMEOUT_MS=15000

# Minimum gap between writes on one token (GitHub asks for ~1 s between mutations at scale).
# GITHUB_MUTATION_MIN_INTERVAL_MS=150

# Attempts for a safely retryable call (writes are never blindly retried).
# GITHUB_RETRY_MAX_ATTEMPTS=4

# First retry delay.
# GITHUB_RETRY_BASE_DELAY_MS=500

# Longest single retry delay.
# GITHUB_RETRY_MAX_DELAY_MS=20000

# Total time budget for retrying one call.
# GITHUB_RETRY_MAX_DURATION_MS=60000

# Random jitter added to retry delays.
# GITHUB_RETRY_JITTER_MS=400

# Longest an interactive request will wait out a rate limit by itself.
# GITHUB_MAX_AUTO_WAIT_MS=30000

# Same, for background jobs.
# GITHUB_BACKGROUND_MAX_AUTO_WAIT_MS=900000

# How long a background request waits before it starts gaining priority.
# GITHUB_BACKGROUND_AGING_MS=30000

# Pause after a secondary-rate-limit response that gives no Retry-After.
# GITHUB_SECONDARY_DEFAULT_WAIT_MS=60000

# Circuit breaker: window in which failures are counted.
# GITHUB_BREAKER_WINDOW_MS=30000

# Circuit breaker: failures in the window that open it.
# GITHUB_BREAKER_MIN_FAILURES=6

# Circuit breaker: how long it stays open.
# GITHUB_BREAKER_COOLDOWN_MS=10000

# Adaptive concurrency: successes before it widens one step.
# GITHUB_AIMD_SUCCESSES_PER_STEP=20

# Short-lived cache for identical in-flight/recent GET requests.
# GITHUB_CACHE_TTL_MS=5000

# Size of that cache.
# GITHUB_CACHE_MAX_ENTRIES=400

# ────────────────────────────────────────────────────────────────────────
# 8 · Webhooks (live alerts)
# ────────────────────────────────────────────────────────────────────────

# GitHub events processed at once.
# WEBHOOK_CONCURRENCY=8

# Events allowed to wait before new ones are shed.
# WEBHOOK_MAX_BACKLOG=500

# Per-repo rate limit; events beyond it are dropped AND counted ("+N more not shown").
# WEBHOOK_MAX_EVENTS_PER_MIN=60

# Events buffered per repo before the oldest are trimmed (and counted).
# WEBHOOK_MAX_BUFFERED_EVENTS=200

# Longest an unsent alert buffer survives in Redis (3 days).
# WEBHOOK_BUFFER_TTL_SECONDS=259200

# ────────────────────────────────────────────────────────────────────────
# 9 · Retention & housekeeping
# Activity-log retention is each person's own setting; access-log retention is editable in the Dashboard's Global Config (default 90 days).
# ────────────────────────────────────────────────────────────────────────

# Rows deleted per batch by the daily sweep.
# RETENTION_BATCH_SIZE=5000

# Batches per sweep per table.
# RETENTION_MAX_BATCHES=200

# Pause between batches so the sweep never hogs the database.
# RETENTION_PAUSE_MS=50

# How long Warden's hourly activity counts are kept.
# WARDEN_BUCKET_RETENTION_DAYS=90

# How long Warden's action log and case history are kept.
# WARDEN_LOG_RETENTION_DAYS=365

# Accounts Warden evaluates per run (least recently evaluated first).
# WARDEN_MAX_USERS=500

# ────────────────────────────────────────────────────────────────────────
# 10 · Health, metrics & diagnostics
# ────────────────────────────────────────────────────────────────────────

# Enables GET /metrics (Prometheus format) for requests carrying "Authorization: Bearer <token>". Disabled when unset.
# METRICS_TOKEN=

# /health reports "degraded" when event-loop lag (p99) exceeds this.
# HEALTH_LOOP_LAG_P99_MS=250

# …or when memory passes this fraction of the watchdog ceiling.
# HEALTH_MEMORY_FRACTION=0.85

# …or when this many queries are waiting for a Postgres connection.
# HEALTH_POOL_WAITERS=5

# Queries slower than this are counted and logged.
# PG_SLOW_QUERY_MS=1000

# A connection held longer than this is counted as a possible leak.
# PG_LONG_HOLD_MS=15000

# Time limit for the GitHub token exchange and for revoking access.
# OAUTH_EXCHANGE_TIMEOUT_MS=10000

# How long the Dashboard's fleet overview is cached.
# ADMIN_STATS_TTL_MS=30000

# Pause between messages when broadcasting (Telegram flood control).
# BROADCAST_GAP_MS=40

# ────────────────────────────────────────────────────────────────────────
# 11 · Instance migration (Owner-only snapshot import)
# ────────────────────────────────────────────────────────────────────────

# Largest snapshot file accepted for import (256 MB).
# MIGRATION_MAX_IMPORT_BYTES=268435456

# Optional "oldColumn:newColumn,…" renames applied while importing an older snapshot.
# IMPORT_COLUMN_ALIASES=

# ────────────────────────────────────────────────────────────────────────
# 12 · First connection (v1.2.5-multi)
# ────────────────────────────────────────────────────────────────────────

# A brand-new person is asked for ALL permissions once (repos, gists, notifications, organisations, projects)
# so nothing needs a second approval later. Set to "off" to ask only for the base permission and request extras on demand.
# FIRST_CONNECT_ALL_SCOPES=on
