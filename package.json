    "test:bot": "node scripts/bot-route-audit.js",
    "test:bot:crawl": "node scripts/bot-navigation-crawler.js",
    "test:bot:mock": "node scripts/bot-mock-runner.js",
    "test:bot:integration": "node scripts/bot-integration-runner.js",
    "test:traffic": "node scripts/traffic-tests.js",
    "test:github": "node scripts/github-e2e-tests.js",
    "test:resources": "node scripts/resource-tests.js",
    "test:warden": "node scripts/warden-tests.js",
    "test:v123": "node scripts/v123-tests.js",
    "test:v124": "node scripts/v124-tests.js",
    "test:v124:areas": "node scripts/v124-areas-tests.js",
    "test:v125": "node scripts/v125-tests.js",
    "test:v130": "node scripts/v130-tests.js",
    "test:v140": "node scripts/v140-tests.js",
    "test:v212": "node scripts/v212-tests.js",
    "test:v213": "node scripts/v213-tests.js",
    "test:v214": "node scripts/v214-tests.js",
    "test:v220": "node scripts/v220-tests.js",
    "test:v221": "node scripts/v221-tests.js",
    "test:v230": "node scripts/v230-tests.js",
    "test:v231": "node scripts/v231-tests.js",
    "test:v232": "node scripts/v232-tests.js",
    "test:v233": "node scripts/v233-tests.js",
    "test:v130:restore": "node scripts/v130-restore-tests.js",
    "load-test": "node scripts/load-test.js"
