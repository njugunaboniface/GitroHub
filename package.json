    "@octokit/rest": "^20.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fuse.js": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.7.13",
    "pg": "^8.12.0",
    "pino": "^9.5.0",
    "redis": "^4.7.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
