{
  "name": "gitrohub",
  "version": "2.3.3-multi",
  "description": "GitroHub \u2014 GitHub from Telegram. Manage your GitHub repos directly from a Telegram bot.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
